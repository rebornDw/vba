Option Explicit

Sub ファイル処理時間集計()

    Dim wsData As Worksheet
    Dim wsResult As Worksheet
    
    Dim lastDataRow As Long
    Dim lastResultRow As Long
    
    Dim dict As Object
    Dim values As Variant
    
    Dim rowIndex As Long
    Dim fileId As String
    
    Dim startTime As Double
    Dim endTime As Double
    Dim processTime As Double
    
    Dim dataSize As Double
    Dim speed As Double
    
    
    Set wsData = ThisWorkbook.Worksheets("data")
    Set wsResult = ThisWorkbook.Worksheets("結果")
    
    Set dict = CreateObject("Scripting.Dictionary")
    
    
    '==========================================
    ' dataシートの最終行を取得
    '==========================================
    lastDataRow = wsData.Cells(wsData.Rows.Count, "A").End(xlUp).Row
    
    
    '==========================================
    ' dataシートを読み込み
    '==========================================
    For rowIndex = 1 To lastDataRow
        
        fileId = Trim(CStr(wsData.Cells(rowIndex, "A").Value))
        
        
        If fileId <> "" _
           And wsData.Cells(rowIndex, "B").Value <> "" _
           And wsData.Cells(rowIndex, "C").Value <> "" Then
            
            
            '------------------------------------------
            ' 開始時間を取得
            '------------------------------------------
            If IsNumeric(wsData.Cells(rowIndex, "B").Value) Then
                
                startTime = CDbl(wsData.Cells(rowIndex, "B").Value)
                
            Else
                
                startTime = CDbl( _
                    TimeValue(Trim(CStr(wsData.Cells(rowIndex, "B").Value))) _
                )
                
            End If
            
            
            '------------------------------------------
            ' 終了時間を取得
            '------------------------------------------
            If IsNumeric(wsData.Cells(rowIndex, "C").Value) Then
                
                endTime = CDbl(wsData.Cells(rowIndex, "C").Value)
                
            Else
                
                endTime = CDbl( _
                    TimeValue(Trim(CStr(wsData.Cells(rowIndex, "C").Value))) _
                )
                
            End If
            
            
            '------------------------------------------
            ' 日付をまたぐ場合
            ' 例：23:59:58 ～ 00:00:03
            '------------------------------------------
            If endTime < startTime Then
                endTime = endTime + 1
            End If
            
            
            '------------------------------------------
            ' 処理時間を秒単位で計算
            '------------------------------------------
            processTime = (endTime - startTime) * 86400
            
            
            '------------------------------------------
            ' データ量を取得
            ' D列の単位は Byte を想定
            '------------------------------------------
            If IsNumeric(wsData.Cells(rowIndex, "D").Value) Then
                
                dataSize = CDbl(wsData.Cells(rowIndex, "D").Value)
                
            Else
                
                dataSize = 0
                
            End If
            
            
            '------------------------------------------
            ' 1件ごとの処理速度を計算
            ' KB / 秒
            '------------------------------------------
            If processTime > 0 Then
                
                speed = (dataSize / 1024) / processTime
                
            Else
                
                speed = 0
                
            End If
            
            
            '==================================================
            ' values の内容
            '
            ' 0  : MAX開始時間
            ' 1  : MAX終了時間
            ' 2  : MIN開始時間
            ' 3  : MIN終了時間
            ' 4  : 開始時間合計
            ' 5  : 終了時間合計
            '
            ' 6  : MAX処理時間
            ' 7  : MIN処理時間
            ' 8  : 処理時間合計
            ' 9  : 処理回数
            '
            ' 10 : MAXデータ量
            ' 11 : MINデータ量
            ' 12 : データ量合計
            '
            ' 13 : 処理速度合計（KB/s）
            ' 14 : 処理速度計算件数
            '==================================================
            
            
            If Not dict.Exists(fileId) Then
                
                values = Array( _
                    startTime, _
                    endTime, _
                    startTime, _
                    endTime, _
                    startTime, _
                    endTime, _
                    processTime, _
                    processTime, _
                    processTime, _
                    1#, _
                    dataSize, _
                    dataSize, _
                    dataSize, _
                    speed, _
                    IIf(processTime > 0, 1#, 0#))
                
                
                dict.Add fileId, values
                
                
            Else
                
                values = dict(fileId)
                
                
                '------------------------------------------
                ' MAX開始時間
                '------------------------------------------
                If startTime > values(0) Then
                    values(0) = startTime
                End If
                
                
                '------------------------------------------
                ' MAX終了時間
                '------------------------------------------
                If endTime > values(1) Then
                    values(1) = endTime
                End If
                
                
                '------------------------------------------
                ' MIN開始時間
                '------------------------------------------
                If startTime < values(2) Then
                    values(2) = startTime
                End If
                
                
                '------------------------------------------
                ' MIN終了時間
                '------------------------------------------
                If endTime < values(3) Then
                    values(3) = endTime
                End If
                
                
                '------------------------------------------
                ' 開始時間合計
                '------------------------------------------
                values(4) = values(4) + startTime
                
                
                '------------------------------------------
                ' 終了時間合計
                '------------------------------------------
                values(5) = values(5) + endTime
                
                
                '------------------------------------------
                ' MAX処理時間
                '------------------------------------------
                If processTime > values(6) Then
                    values(6) = processTime
                End If
                
                
                '------------------------------------------
                ' MIN処理時間
                '------------------------------------------
                If processTime < values(7) Then
                    values(7) = processTime
                End If
                
                
                '------------------------------------------
                ' 処理時間合計
                '------------------------------------------
                values(8) = values(8) + processTime
                
                
                '------------------------------------------
                ' 処理回数
                '------------------------------------------
                values(9) = values(9) + 1
                
                
                '------------------------------------------
                ' MAXデータ量
                '------------------------------------------
                If dataSize > values(10) Then
                    values(10) = dataSize
                End If
                
                
                '------------------------------------------
                ' MINデータ量
                '------------------------------------------
                If dataSize < values(11) Then
                    values(11) = dataSize
                End If
                
                
                '------------------------------------------
                ' データ量合計
                '------------------------------------------
                values(12) = values(12) + dataSize
                
                
                '------------------------------------------
                ' 処理速度合計
                ' 0秒のデータは平均対象外
                '------------------------------------------
                If processTime > 0 Then
                    
                    values(13) = values(13) + speed
                    values(14) = values(14) + 1
                    
                End If
                
                
                dict(fileId) = values
                
            End If
            
        End If
        
    Next rowIndex
    
    
    '==========================================
    ' 結果シートの最終行を取得
    '==========================================
    lastResultRow = wsResult.Cells(wsResult.Rows.Count, "A").End(xlUp).Row
    
    
    '==========================================
    ' 結果シートへ出力
    '==========================================
    For rowIndex = 2 To lastResultRow
        
        fileId = Trim(CStr(wsResult.Cells(rowIndex, "A").Value))
        
        
        If dict.Exists(fileId) Then
            
            values = dict(fileId)
            
            
            'B列：MAX開始時間
            wsResult.Cells(rowIndex, "B").Value = values(0)
            
            
            'C列：MAX終了時間
            wsResult.Cells(rowIndex, "C").Value = values(1)
            
            
            'D列：MIN開始時間
            wsResult.Cells(rowIndex, "D").Value = values(2)
            
            
            'E列：MIN終了時間
            wsResult.Cells(rowIndex, "E").Value = values(3)
            
            
            'F列：AVG開始時間
            wsResult.Cells(rowIndex, "F").Value = _
                values(4) / values(9)
            
            
            'G列：AVG終了時間
            wsResult.Cells(rowIndex, "G").Value = _
                values(5) / values(9)
            
            
            'H列：MAX処理時間
            wsResult.Cells(rowIndex, "H").Value = values(6)
            
            
            'I列：MIN処理時間
            wsResult.Cells(rowIndex, "I").Value = values(7)
            
            
            'J列：AVG処理時間
            wsResult.Cells(rowIndex, "J").Value = _
                values(8) / values(9)
            
            
            'K列：MAXデータ量
            wsResult.Cells(rowIndex, "K").Value = values(10)
            
            
            'L列：MINデータ量
            wsResult.Cells(rowIndex, "L").Value = values(11)
            
            
            'M列：AVGデータ量
            wsResult.Cells(rowIndex, "M").Value = _
                values(12) / values(9)
            
            
            'N列：AVG(DATA(KB) / TIME(S))
            '各レコードのKB/sを計算し、その平均値を出力
            If values(14) > 0 Then
                
                wsResult.Cells(rowIndex, "N").Value = _
                    values(13) / values(14)
                
            Else
                
                wsResult.Cells(rowIndex, "N").Value = 0
                
            End If
            
            
        Else
            
            'dataシートに対象ファイルIDが存在しない場合
            wsResult.Range("B" & rowIndex & ":N" & rowIndex).ClearContents
            
        End If
        
    Next rowIndex
    
    
    '==========================================
    ' 表示形式
    '==========================================
    
    '開始時間・終了時間
    wsResult.Range("B2:G" & lastResultRow).NumberFormat = "hh:mm:ss"
    
    
    '処理時間（秒）
    wsResult.Range("H2:J" & lastResultRow).NumberFormat = "0.000"
    
    
    'データ量
    wsResult.Range("K2:M" & lastResultRow).NumberFormat = "0.000"
    
    
    '平均処理速度（KB/s）
    wsResult.Range("N2:N" & lastResultRow).NumberFormat = "0.000"
    
    
    MsgBox "集計が完了しました。", vbInformation

End Sub
